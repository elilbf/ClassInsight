# Environment variables for docker-compose (do not commit secrets to VCS; add this file to .gitignore)
# Application (prod profile) values
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://classinsight-postgres:5432/classinsight_db
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Application wrapper variables used by application-prod.yaml
DB_USERNAME=classinsight_user
DB_PASSWORD=classinsight_pass

# Postgres init values
POSTGRES_DB=classinsight_db
POSTGRES_USER=classinsight_user
POSTGRES_PASSWORD=classinsight_pass

